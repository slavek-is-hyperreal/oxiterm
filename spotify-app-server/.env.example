# Spotify App Configuration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=https://oxiterm.slavekm.pl/callback
OXITERM_APP_TOKEN=your_app_token_here
OXITERM_URL=http://host.docker.internal:8087
PORT=8889

# Polling & Activity Ladder Configuration
POLL_PLAYING_S=25.0
POLL_PAUSED_S=60.0
POLL_IDLE_S=90.0
POLL_END_GRACE_MS=800
POLL_MIN_GAP_S=1.0
POLL_LADDER_S=0.4,1,2,3,5,8,12,20
TICK_FALLBACK_S=1.0
SPOTIFY_BUDGET_PER_30S=20
BREAKER_DEFAULT_S=30.0
SPOTIFY_PANEL_PAGES=spotify/panel.thtml,spotify/panel_mobile.thtml
