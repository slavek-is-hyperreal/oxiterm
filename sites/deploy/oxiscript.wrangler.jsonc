// Cloudflare Worker with static assets for oxiscript.slavekm.pl. Deploy (after sites/build.sh):
//   npx wrangler@4.86.0 deploy --config sites/deploy/oxiscript.wrangler.jsonc
{
  "name": "oxiscript",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../dist/oxiscript",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "routes": [{ "pattern": "oxiscript.slavekm.pl", "custom_domain": true }]
}
