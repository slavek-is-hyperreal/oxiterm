// OxiPerf p02 map_set (STDLIB track): std/collections Map and Set against each language's
// built-in hash map. Checksums use lookups, sizes and sums only, never iteration order.
import { Map, Set } from "std/collections";

function nextRand(x: u32): u32 {
  let y = x;
  y = y ^ (y << 13u32);
  y = y ^ (y >> 17u32);
  y = y ^ (y << 5u32);
  return y;
}

@host export function run(n: i32): u32 {
  const range = (n * 2) as u32;
  let s: u32 = 88172645u32;
  const m = new Map<i32, i32>();
  const seen = new Set<i32>();
  for (let i = 0; i < n; i++) {
    s = nextRand(s);
    const k = (s % range) as i32;
    m.set(k, i);
    seen.add(k);
  }
  let h: u32 = 0u32;
  for (let i = 0; i < n; i++) {
    s = nextRand(s);
    const k = (s % range) as i32;
    const v = m.get(k) ?? -1;
    h = (h *% 31u32) +% v.wrapping<u32>();
  }
  for (let i = 0; i < n; i++) {
    s = nextRand(s);
    const k = (s % range) as i32;
    if (m.has(k)) {
      m.remove(k);
    }
  }
  h = (h *% 31u32) +% (m.size() as u32);
  h = (h *% 31u32) +% (seen.size() as u32);
  return h;
}

export function main(): void {}
