// OxiPerf awfy_mandelbrot: our port of the Are We Fast Yet Mandelbrot (P01), following upstream
// mandelbrot.js (escape-time loop, 50 iterations, limit 4.0, 8-bit packed rows folded with xor).
// run(500) must give 191.

@host export function run(n: i32): u32 {
  const size = n;
  let sum: i32 = 0;
  let byteAcc: i32 = 0;
  let bitNum: i32 = 0;
  let y: i32 = 0;
  while (y < size) {
    const ci = ((2.0 * (y as f64)) / (size as f64)) - 1.0;
    let x: i32 = 0;
    while (x < size) {
      let zrzr = 0.0;
      let zi = 0.0;
      let zizi = 0.0;
      const cr = ((2.0 * (x as f64)) / (size as f64)) - 1.5;
      let z: i32 = 0;
      let notDone = true;
      let escape: i32 = 0;
      while (notDone && z < 50) {
        const zr = zrzr - zizi + cr;
        zi = 2.0 * zr * zi + ci;
        zrzr = zr * zr;
        zizi = zi * zi;
        if (zrzr + zizi > 4.0) {
          notDone = false;
          escape = 1;
        }
        z += 1;
      }
      byteAcc = (byteAcc << 1) + escape;
      bitNum += 1;
      if (bitNum === 8) {
        sum = sum ^ byteAcc;
        byteAcc = 0;
        bitNum = 0;
      } else if (x === size - 1) {
        byteAcc = byteAcc << (8 - bitNum);
        sum = sum ^ byteAcc;
        byteAcc = 0;
        bitNum = 0;
      }
      x += 1;
    }
    y += 1;
  }
  return sum as u32;
}

export function main(): void {}
