function bits(a: u32, b: u32, c: u32 | null, d: u32 | null, e: bool | null, f: bool): u32 {
  const x = (a << 2) | (b >> 3);
  const y = a & b & 0xff;
  const z = a | b | 1;
  const w = a ^ b ^ 1;
  const v = (a & b) | (a ^ b);
  const u = a << (b + 1);
  const t = (a + b) >> 1;
  const s = c ?? d ?? 1;
  const r = (e ?? f) || true;
  return x + y + z + w + v + u + t;
}
