function identity<T>(x: T): T {
  return x;
}

function first<T, U extends Shape>(a: T, b: U): T {
  return a;
}

interface Shape {
  area(): f64;
}

struct Box<T> {
  value: T;
}

const x = identity<i32>(5);
const y = first<i32, Circle>(1, { r: 1.0 });
const z: Array<Array<i32>> = [[1, 2], [3]];
const w: Array<i32>= [1];
const nested: Box<Array<Box<i32>>> = { value: [] };

struct Circle implements Shape {
  r: f64;
  area(): f64 { return 3.14 * this.r * this.r; }
}
