function someFunction(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32, i: i32, j: i32, k: i32): i32 { return a; }
function long(alpha: i32, beta: i32, gamma: i32, delta: i32, epsilon: i32, zeta: i32, eta: i32): i32 {
  const sum = alpha + beta + gamma + delta + epsilon + zeta + eta + alpha * beta * gamma * delta * epsilon * zeta * eta;
  const call = someFunction(alpha, beta, gamma, delta, epsilon, zeta, eta, alpha, beta, gamma, delta);
  const cond = alpha > beta ? gamma + delta + epsilon + zeta + eta + alpha + beta + gamma : delta - epsilon - zeta - eta - alpha;
  const arr = [alpha, beta, gamma, delta, epsilon, zeta, eta, alpha, beta, gamma, delta, epsilon, zeta, eta, 1, 2, 3];
  if (alpha > beta && beta > gamma && gamma > delta && delta > epsilon && epsilon > zeta && zeta > eta && eta > 0) {
    return sum;
  }
  return call + cond + arr[0];
}
type Big = { aaaaaaaaaaaa: i32; bbbbbbbbbbbbbbb: i32; ccccccccccccccc: i32; dddddddddddddd: i32; eeeeeeeeeeeee: i32 };
