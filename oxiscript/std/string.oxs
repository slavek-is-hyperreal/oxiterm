// OxiScript standard library: std/string
// UTF-8 string manipulation, parsing, and deterministic number formatting.

import { INF, NEG_INF, NAN, I32_MIN, I32_MAX, I64_MIN, I64_MAX, bitsOf, fromBits, clz32, clz64 } from "std/math";

@intrinsic("str_byte")
export function byteAt(s: string, idx: i32): u8 {
  return 0u8;
}

@intrinsic("str_cmp")
export function compare(a: string, b: string): i32 {
  return 0;
}

@intrinsic("str_from_utf8")
function strFromUtf8Raw(bytes: u8[], len: i32): string {
  return "";
}

function isAsciiSpace(b: u8): bool {
  return b === 32u8 || b === 9u8 || b === 10u8 || b === 13u8 || b === 11u8 || b === 12u8;
}

function utf8SeqLen(lead: u8): i32 {
  if (lead < 0x80u8) {
    return 1;
  }
  if (lead < 0xe0u8) {
    return 2;
  }
  if (lead < 0xf0u8) {
    return 3;
  }
  return 4;
}

export function isEmpty(s: string): bool {
  return s.byteLength === 0;
}

export function charCount(s: string): i32 {
  const n = s.byteLength;
  let i: i32 = 0;
  let count: i32 = 0;
  while (i < n) {
    i += utf8SeqLen(byteAt(s, i));
    count++;
  }
  return count;
}

export function fromUtf8(bytes: u8[]): Result<string, string> {
  const n = bytes.length;
  let i: i32 = 0;
  while (i < n) {
    const b0 = bytes[i];
    if (b0 < 0x80u8) {
      i += 1;
    } else if (b0 >= 0xc2u8 && b0 <= 0xdfu8) {
      if (i + 1 >= n) {
        return Err("truncated UTF-8 sequence");
      }
      const b1 = bytes[i + 1];
      if ((b1 & 0xc0u8) !== 0x80u8) {
        return Err("invalid UTF-8 continuation byte");
      }
      i += 2;
    } else if (b0 >= 0xe0u8 && b0 <= 0xefu8) {
      if (i + 2 >= n) {
        return Err("truncated UTF-8 sequence");
      }
      const b1 = bytes[i + 1];
      const b2 = bytes[i + 2];
      if ((b1 & 0xc0u8) !== 0x80u8 || (b2 & 0xc0u8) !== 0x80u8) {
        return Err("invalid UTF-8 continuation byte");
      }
      if (b0 === 0xe0u8 && b1 < 0xa0u8) {
        return Err("overlong UTF-8 sequence");
      }
      if (b0 === 0xedu8 && b1 >= 0xa0u8) {
        return Err("UTF-8 surrogate code point");
      }
      i += 3;
    } else if (b0 >= 0xf0u8 && b0 <= 0xf4u8) {
      if (i + 3 >= n) {
        return Err("truncated UTF-8 sequence");
      }
      const b1 = bytes[i + 1];
      const b2 = bytes[i + 2];
      const b3 = bytes[i + 3];
      if ((b1 & 0xc0u8) !== 0x80u8 || (b2 & 0xc0u8) !== 0x80u8 || (b3 & 0xc0u8) !== 0x80u8) {
        return Err("invalid UTF-8 continuation byte");
      }
      if (b0 === 0xf0u8 && b1 < 0x90u8) {
        return Err("overlong UTF-8 sequence");
      }
      if (b0 === 0xf4u8 && b1 >= 0x90u8) {
        return Err("UTF-8 code point above U+10FFFF");
      }
      i += 4;
    } else {
      return Err("invalid UTF-8 leading byte");
    }
  }
  return Ok(strFromUtf8Raw(bytes, n));
}

export function fromCodePoint(cp: u32): Result<string, string> {
  if (cp > 0x10_ffffu32 || (cp >= 0xd800u32 && cp <= 0xdfffu32)) {
    return Err("invalid Unicode scalar value");
  }
  const buf: u8[] = [];
  if (cp < 0x80u32) {
    buf.push(cp as u8);
  } else if (cp < 0x800u32) {
    buf.push((0xc0u32 | (cp >> 6u32)) as u8);
    buf.push((0x80u32 | (cp & 0x3fu32)) as u8);
  } else if (cp < 0x10000u32) {
    buf.push((0xe0u32 | (cp >> 12u32)) as u8);
    buf.push((0x80u32 | ((cp >> 6u32) & 0x3fu32)) as u8);
    buf.push((0x80u32 | (cp & 0x3fu32)) as u8);
  } else {
    buf.push((0xf0u32 | (cp >> 18u32)) as u8);
    buf.push((0x80u32 | ((cp >> 12u32) & 0x3fu32)) as u8);
    buf.push((0x80u32 | ((cp >> 6u32) & 0x3fu32)) as u8);
    buf.push((0x80u32 | (cp & 0x3fu32)) as u8);
  }
  return Ok(strFromUtf8Raw(buf, buf.length));
}

export function trimStart(s: string): string {
  const n = s.byteLength;
  let i: i32 = 0;
  while (i < n && isAsciiSpace(byteAt(s, i))) {
    i++;
  }
  return s.slice(i, n);
}

export function trimEnd(s: string): string {
  let end = s.byteLength;
  while (end > 0 && isAsciiSpace(byteAt(s, end - 1))) {
    end--;
  }
  return s.slice(0, end);
}

export function trim(s: string): string {
  const n = s.byteLength;
  let lo: i32 = 0;
  while (lo < n && isAsciiSpace(byteAt(s, lo))) {
    lo++;
  }
  let hi = n;
  while (hi > lo && isAsciiSpace(byteAt(s, hi - 1))) {
    hi--;
  }
  if (lo === 0 && hi === n) {
    return s;
  }
  return s.slice(lo, hi);
}

function matchAt(s: string, pos: i32, needle: string): bool {
  const m = needle.byteLength;
  if (pos + m > s.byteLength) {
    return false;
  }
  let j: i32 = 0;
  while (j < m) {
    if (byteAt(s, pos + j) !== byteAt(needle, j)) {
      return false;
    }
    j++;
  }
  return true;
}

function indexOfFrom(s: string, needle: string, start: i32): i32 {
  const n = s.byteLength;
  const m = needle.byteLength;
  if (m === 0) {
    return start <= n ? start : -1;
  }
  const lim = n - m;
  let i = start;
  while (i <= lim) {
    if (matchAt(s, i, needle)) {
      return i;
    }
    i++;
  }
  return -1;
}

export function lastIndexOf(s: string, needle: string): i32 {
  const n = s.byteLength;
  const m = needle.byteLength;
  if (m === 0) {
    return n;
  }
  if (m > n) {
    return -1;
  }
  let i = n - m;
  while (i >= 0) {
    if (matchAt(s, i, needle)) {
      return i;
    }
    i--;
  }
  return -1;
}

function pushStrBytes(buf: u8[], s: string): void {
  const n = s.byteLength;
  let i: i32 = 0;
  while (i < n) {
    buf.push(byteAt(s, i));
    i++;
  }
}

function pushSliceBytes(buf: u8[], s: string, lo: i32, hi: i32): void {
  let i = lo;
  while (i < hi) {
    buf.push(byteAt(s, i));
    i++;
  }
}

export function split(s: string, sep: string): string[] {
  const out: string[] = [];
  const n = s.byteLength;
  const m = sep.byteLength;
  if (m === 0) {
    let i: i32 = 0;
    while (i < n) {
      const step = utf8SeqLen(byteAt(s, i));
      out.push(s.slice(i, i + step));
      i += step;
    }
    return out;
  }
  let start: i32 = 0;
  while (start <= n) {
    const pos = indexOfFrom(s, sep, start);
    if (pos < 0) {
      out.push(s.slice(start, n));
      break;
    }
    out.push(s.slice(start, pos));
    start = pos + m;
  }
  return out;
}

export function replace(s: string, from: string, to: string): string {
  const m = from.byteLength;
  if (m === 0) {
    return `${to}${s}`;
  }
  const pos = s.indexOf(from);
  if (pos < 0) {
    return s;
  }
  const buf: u8[] = [];
  pushSliceBytes(buf, s, 0, pos);
  pushStrBytes(buf, to);
  pushSliceBytes(buf, s, pos + m, s.byteLength);
  return strFromUtf8Raw(buf, buf.length);
}

export function replaceAll(s: string, from: string, to: string): string {
  const n = s.byteLength;
  const m = from.byteLength;
  const buf: u8[] = [];
  if (m === 0) {
    pushStrBytes(buf, to);
    let i: i32 = 0;
    while (i < n) {
      const step = utf8SeqLen(byteAt(s, i));
      pushSliceBytes(buf, s, i, i + step);
      pushStrBytes(buf, to);
      i += step;
    }
    return strFromUtf8Raw(buf, buf.length);
  }
  let start: i32 = 0;
  while (start <= n) {
    const pos = indexOfFrom(s, from, start);
    if (pos < 0) {
      pushSliceBytes(buf, s, start, n);
      break;
    }
    pushSliceBytes(buf, s, start, pos);
    pushStrBytes(buf, to);
    start = pos + m;
  }
  return strFromUtf8Raw(buf, buf.length);
}

export function repeat(s: string, count: i32): string {
  if (count <= 0 || s.byteLength === 0) {
    return "";
  }
  if (count === 1) {
    return s;
  }
  let res = "";
  let chunk = s;
  let rem = count;
  while (rem > 0) {
    if ((rem & 1) !== 0) {
      res = `${res}${chunk}`;
    }
    rem = rem >> 1;
    if (rem > 0) {
      chunk = `${chunk}${chunk}`;
    }
  }
  return res;
}

function appendPadChars(buf: u8[], pad: string, needChars: i32): void {
  const plen = pad.byteLength;
  if (plen === 0 || needChars <= 0) {
    return;
  }
  let added: i32 = 0;
  while (added < needChars) {
    let i: i32 = 0;
    while (i < plen && added < needChars) {
      const step = utf8SeqLen(byteAt(pad, i));
      pushSliceBytes(buf, pad, i, i + step);
      i += step;
      added++;
    }
  }
}

export function padStart(s: string, targetLen: i32, pad: string = " "): string {
  const cur = charCount(s);
  if (targetLen <= cur || pad.byteLength === 0) {
    return s;
  }
  const buf: u8[] = [];
  appendPadChars(buf, pad, targetLen - cur);
  pushStrBytes(buf, s);
  return strFromUtf8Raw(buf, buf.length);
}

export function padEnd(s: string, targetLen: i32, pad: string = " "): string {
  const cur = charCount(s);
  if (targetLen <= cur || pad.byteLength === 0) {
    return s;
  }
  const buf: u8[] = [];
  pushStrBytes(buf, s);
  appendPadChars(buf, pad, targetLen - cur);
  return strFromUtf8Raw(buf, buf.length);
}

export function toUpperAscii(s: string): string {
  const n = s.byteLength;
  const buf: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    const b = byteAt(s, i);
    if (b >= 97u8 && b <= 122u8) {
      buf.push(b - 32u8);
    } else {
      buf.push(b);
    }
    i++;
  }
  return strFromUtf8Raw(buf, n);
}

export function toLowerAscii(s: string): string {
  const n = s.byteLength;
  const buf: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    const b = byteAt(s, i);
    if (b >= 65u8 && b <= 90u8) {
      buf.push(b + 32u8);
    } else {
      buf.push(b);
    }
    i++;
  }
  return strFromUtf8Raw(buf, n);
}

// -----------------------------------------------------------------------------
// Parsing: parseInt / parseInt32 / parseFloat
// -----------------------------------------------------------------------------

function digitVal(b: u8): i32 {
  if (b >= 48u8 && b <= 57u8) {
    return (b - 48u8) as i32;
  }
  if (b >= 65u8 && b <= 90u8) {
    return ((b - 65u8) as i32) + 10;
  }
  if (b >= 97u8 && b <= 122u8) {
    return ((b - 97u8) as i32) + 10;
  }
  return -1;
}

export function parseInt(s: string, radix: i32 = 10): Result<i64, string> {
  if (radix < 2 || radix > 36) {
    return Err("radix must be between 2 and 36");
  }
  const t = trim(s);
  const n = t.byteLength;
  if (n === 0) {
    return Err("empty integer string");
  }
  let i: i32 = 0;
  let neg = false;
  const first = byteAt(t, 0);
  if (first === 45u8) {
    neg = true;
    i = 1;
  } else if (first === 43u8) {
    i = 1;
  }
  if (i >= n) {
    return Err("missing digits");
  }
  const limit: u64 = neg ? 9223372036854775808u64 : 9223372036854775807u64;
  const base: u64 = radix as u64;
  let acc: u64 = 0u64;
  while (i < n) {
    const d = digitVal(byteAt(t, i));
    if (d < 0 || d >= radix) {
      return Err("invalid digit");
    }
    const du: u64 = d as u64;
    if (acc > (limit - du) / base) {
      return Err("integer overflow");
    }
    acc = acc * base + du;
    i++;
  }
  if (neg) {
    if (acc === 9223372036854775808u64) {
      return Ok(I64_MIN);
    }
    return Ok(-(acc as i64));
  }
  return Ok(acc as i64);
}

export function parseInt32(s: string, radix: i32 = 10): Result<i32, string> {
  const v = parseInt(s, radix)?;
  if (v < (I32_MIN as i64) || v > (I32_MAX as i64)) {
    return Err("i32 overflow");
  }
  return Ok(v as i32);
}

// -----------------------------------------------------------------------------
// Exact 128-bit and BigUint arithmetic helpers for parseFloat and toFixed
//
// parseFloat implements correctly-rounded (IEEE-754 round-to-nearest-even)
// decimal-to-binary64 conversion:
//   1. Clinger (1990) exact f64 fast path for <= 53-bit significand, |e| <= 22.
//   2. Eisel-Lemire 128-bit fast path:
//        Daniel Lemire, "Number Parsing at a Gigabyte per Second",
//        Software: Practice and Experience 51(8), 2021 (as in Rust core::num::dec2flt
//        and fast_float), using a 44-entry coarse 128-bit power-of-5 table (step 16)
//        combined with exact 5^0..5^15 (proven error < 3 ULPs of 128-bit mantissa).
//   3. Exact arbitrary-precision BigUint fallback (base-2^32 limbs, truncating at
//      768 significant digits with sticky bit per Gay 1990 / Clinger 1990) for
//      long digit strings and all near-halfway / subnormal tie cases.
//
// toFixed formats the exact binary64 value in fixed-point decimal with exact
// round-to-nearest-even on the exact value (no "-0"), supporting all finite f64
// values including f64::MAX without trapping.
// -----------------------------------------------------------------------------

function mul64Hi(a: u64, b: u64): u64 {
  const aLo = a & 0xffff_ffffu64;
  const aHi = a >> 32u64;
  const bLo = b & 0xffff_ffffu64;
  const bHi = b >> 32u64;
  const p00 = aLo *% bLo;
  const p01 = aLo *% bHi;
  const p10 = aHi *% bLo;
  const p11 = aHi *% bHi;
  const mid = (p00 >> 32u64) +% (p01 & 0xffff_ffffu64) +% (p10 & 0xffff_ffffu64);
  return p11 +% (p01 >> 32u64) +% (p10 >> 32u64) +% (mid >> 32u64);
}

function pow5Small(r: i32): u64 {
  switch (r) {
    case 0: return 1u64;
    case 1: return 5u64;
    case 2: return 25u64;
    case 3: return 125u64;
    case 4: return 625u64;
    case 5: return 3125u64;
    case 6: return 15625u64;
    case 7: return 78125u64;
    case 8: return 390625u64;
    case 9: return 1953125u64;
    case 10: return 9765625u64;
    case 11: return 48828125u64;
    case 12: return 244140625u64;
    case 13: return 1220703125u64;
    case 14: return 6103515625u64;
    case 15: return 30517578125u64;
    case 16: return 152587890625u64;
    case 17: return 762939453125u64;
    case 18: return 3814697265625u64;
    case 19: return 19073486328125u64;
    default: return 95367431640625u64;
  }
}

function pow10Exact(e: i32): f64 {
  switch (e) {
    case 0: return 1.0;
    case 1: return 1e1;
    case 2: return 1e2;
    case 3: return 1e3;
    case 4: return 1e4;
    case 5: return 1e5;
    case 6: return 1e6;
    case 7: return 1e7;
    case 8: return 1e8;
    case 9: return 1e9;
    case 10: return 1e10;
    case 11: return 1e11;
    case 12: return 1e12;
    case 13: return 1e13;
    case 14: return 1e14;
    case 15: return 1e15;
    case 16: return 1e16;
    case 17: return 1e17;
    case 18: return 1e18;
    case 19: return 1e19;
    case 20: return 1e20;
    case 21: return 1e21;
    default: return 1e22;
  }
}

// Normalized 128-bit floor approximations of 5^(-352 + 16*k) for k in 0..=43:
// (hi * 2^64 + lo) * 2^exp <= 5^(-352 + 16*k) < (hi * 2^64 + lo + 1) * 2^exp.
function pow5CoarseHi(k: i32): u64 {
  switch (k) {
    case 0: return 0xcd42a11346f34f7du64;
    case 1: return 0xe3e27a444d8d98b7u64;
    case 2: return 0xfd00b897478238d0u64;
    case 3: return 0x8c71dcd9ba0b4925u64;
    case 4: return 0x9becce62836ac577u64;
    case 5: return 0xad1c8eab5ee43b66u64;
    case 6: return 0xc0314325637a1939u64;
    case 7: return 0xd5605fcdcf32e1d6u64;
    case 8: return 0xece53cec4a314ebdu64;
    case 9: return 0x8380dea93da4bc60u64;
    case 10: return 0x91ff83775423cc06u64;
    case 11: return 0xa21727db38cb002fu64;
    case 12: return 0xb3f4e093db73a093u64;
    case 13: return 0xc7caba6e7c5382c8u64;
    case 14: return 0xddd0467c64bce4a0u64;
    case 15: return 0xf64335bcf065d37du64;
    case 16: return 0x88b402f7fd75539bu64;
    case 17: return 0x97c560ba6b0919a5u64;
    case 18: return 0xa87fea27a539e9a5u64;
    case 19: return 0xbb127c53b17ec159u64;
    case 20: return 0xcfb11ead453994bau64;
    case 21: return 0xe69594bec44de15bu64;
    case 22: return 0x8000000000000000u64;
    case 23: return 0x8e1bc9bf04000000u64;
    case 24: return 0x9dc5ada82b70b59du64;
    case 25: return 0xaf298d050e4395d6u64;
    case 26: return 0xc2781f49ffcfa6d5u64;
    case 27: return 0xd7e77a8f87daf7fbu64;
    case 28: return 0xefb3ab16c59b14a2u64;
    case 29: return 0x850fadc09923329eu64;
    case 30: return 0x93ba47c980e98cdfu64;
    case 31: return 0xa402b9c5a8d3a6e7u64;
    case 32: return 0xb616a12b7fe617aau64;
    case 33: return 0xca28a291859bbf93u64;
    case 34: return 0xe070f78d3927556au64;
    case 35: return 0xf92e0c3537826145u64;
    case 36: return 0x8a5296ffe33cc92fu64;
    case 37: return 0x9991a6f3d6bf1765u64;
    case 38: return 0xaa7eebfb9df9de8du64;
    case 39: return 0xbd49d14aa79dbc82u64;
    case 40: return 0xd226fc195c6a2f8cu64;
    case 41: return 0xe950df20247c83fdu64;
    case 42: return 0x81842f29f2cce375u64;
    default: return 0x8fcac257558ee4e6u64;
  }
}

function pow5CoarseLo(k: i32): u64 {
  switch (k) {
    case 0: return 0x0092757bf2623727u64;
    case 1: return 0xfd1b1b2308169b25u64;
    case 2: return 0x8920b098955522b4u64;
    case 3: return 0x9ff0c08b7f1d0b14u64;
    case 4: return 0x4ee367f9430aec32u64;
    case 5: return 0xda3243650005eecfu64;
    case 6: return 0xfa911155fefb5308u64;
    case 7: return 0xfb1e4a9a90880a64u64;
    case 8: return 0xa4f8bf5635246428u64;
    case 9: return 0x4247cb9e59f71e6du64;
    case 10: return 0x7b6306a34627ddcfu64;
    case 11: return 0xb8ada00e5a506a7cu64;
    case 12: return 0x59ed216765690f56u64;
    case 13: return 0xfe64a52ee96b8fc0u64;
    case 14: return 0xac7cb3f6d05ddbdeu64;
    case 15: return 0x4d4617b5ff4a16d5u64;
    case 16: return 0x11dbcb0218ebb414u64;
    case 17: return 0xdccd879fc967d41au64;
    case 18: return 0x3f2398d747b36224u64;
    case 19: return 0x5560c018580d5d52u64;
    case 20: return 0x67de18eda5814af2u64;
    case 21: return 0x4c2ebe687989a9b3u64;
    case 22: return 0x0000000000000000u64;
    case 23: return 0x0000000000000000u64;
    case 24: return 0xf020000000000000u64;
    case 25: return 0x9670b12b7f410000u64;
    case 26: return 0x3cbf6b71c76b25fbu64;
    case 27: return 0xdc33745ec97be906u64;
    case 28: return 0xc5cfe94ef3ea101eu64;
    case 29: return 0x03e2cf6bc604ddb0u64;
    case 30: return 0xc66f336c36b10137u64;
    case 31: return 0x5f16206c9c6209a6u64;
