// OxiScript standard library: std/string
// UTF-8 string manipulation, parsing, and deterministic number formatting.

import { INF, NEG_INF, NAN, I32_MIN, I32_MAX, I64_MIN, I64_MAX, floor, abs } from "std/math";

@intrinsic("str_byte")
export function byteAt(s: string, idx: i32): u8 {
  return 0u8;
}

@intrinsic("str_cmp")
export function compare(a: string, b: string): i32 {
  return 0;
}

@intrinsic("str_from_utf8")
function strFromUtf8Raw(bytes: u8[], len: i32): string {
  return "";
}

function isAsciiSpace(b: u8): bool {
  return b === 32u8 || b === 9u8 || b === 10u8 || b === 13u8 || b === 11u8 || b === 12u8;
}

function utf8SeqLen(lead: u8): i32 {
  if (lead < 0x80u8) {
    return 1;
  }
  if (lead < 0xe0u8) {
    return 2;
  }
  if (lead < 0xf0u8) {
    return 3;
  }
  return 4;
}

export function isEmpty(s: string): bool {
  return s.byteLength === 0;
}

export function charCount(s: string): i32 {
  const n = s.byteLength;
  let i: i32 = 0;
  let count: i32 = 0;
  while (i < n) {
    i += utf8SeqLen(byteAt(s, i));
    count++;
  }
  return count;
}

export function fromUtf8(bytes: u8[]): Result<string, string> {
  const n = bytes.length;
  let i: i32 = 0;
  while (i < n) {
    const b0 = bytes[i];
    if (b0 < 0x80u8) {
      i += 1;
    } else if (b0 >= 0xc2u8 && b0 <= 0xdfu8) {
      if (i + 1 >= n) {
        return Err("truncated UTF-8 sequence");
      }
      const b1 = bytes[i + 1];
      if ((b1 & 0xc0u8) !== 0x80u8) {
        return Err("invalid UTF-8 continuation byte");
      }
      i += 2;
    } else if (b0 >= 0xe0u8 && b0 <= 0xefu8) {
      if (i + 2 >= n) {
        return Err("truncated UTF-8 sequence");
      }
      const b1 = bytes[i + 1];
      const b2 = bytes[i + 2];
      if ((b1 & 0xc0u8) !== 0x80u8 || (b2 & 0xc0u8) !== 0x80u8) {
        return Err("invalid UTF-8 continuation byte");
      }
      if (b0 === 0xe0u8 && b1 < 0xa0u8) {
        return Err("overlong UTF-8 sequence");
      }
      if (b0 === 0xedu8 && b1 >= 0xa0u8) {
        return Err("UTF-8 surrogate code point");
      }
      i += 3;
    } else if (b0 >= 0xf0u8 && b0 <= 0xf4u8) {
      if (i + 3 >= n) {
        return Err("truncated UTF-8 sequence");
      }
      const b1 = bytes[i + 1];
      const b2 = bytes[i + 2];
      const b3 = bytes[i + 3];
      if ((b1 & 0xc0u8) !== 0x80u8 || (b2 & 0xc0u8) !== 0x80u8 || (b3 & 0xc0u8) !== 0x80u8) {
        return Err("invalid UTF-8 continuation byte");
      }
      if (b0 === 0xf0u8 && b1 < 0x90u8) {
        return Err("overlong UTF-8 sequence");
      }
      if (b0 === 0xf4u8 && b1 >= 0x90u8) {
        return Err("UTF-8 code point above U+10FFFF");
      }
      i += 4;
    } else {
      return Err("invalid UTF-8 leading byte");
    }
  }
  return Ok(strFromUtf8Raw(bytes, n));
}

export function fromCodePoint(cp: u32): Result<string, string> {
  if (cp > 0x10_ffffu32 || (cp >= 0xd800u32 && cp <= 0xdfffu32)) {
    return Err("invalid Unicode scalar value");
  }
  const buf: u8[] = [];
  if (cp < 0x80u32) {
    buf.push(cp as u8);
  } else if (cp < 0x800u32) {
    buf.push((0xc0u32 | (cp >> 6u32)) as u8);
    buf.push((0x80u32 | (cp & 0x3fu32)) as u8);
  } else if (cp < 0x10000u32) {
    buf.push((0xe0u32 | (cp >> 12u32)) as u8);
    buf.push((0x80u32 | ((cp >> 6u32) & 0x3fu32)) as u8);
    buf.push((0x80u32 | (cp & 0x3fu32)) as u8);
  } else {
    buf.push((0xf0u32 | (cp >> 18u32)) as u8);
    buf.push((0x80u32 | ((cp >> 12u32) & 0x3fu32)) as u8);
    buf.push((0x80u32 | ((cp >> 6u32) & 0x3fu32)) as u8);
    buf.push((0x80u32 | (cp & 0x3fu32)) as u8);
  }
  return Ok(strFromUtf8Raw(buf, buf.length));
}

export function trimStart(s: string): string {
  const n = s.byteLength;
  let i: i32 = 0;
  while (i < n && isAsciiSpace(byteAt(s, i))) {
    i++;
  }
  return s.slice(i, n);
}

export function trimEnd(s: string): string {
  let end = s.byteLength;
  while (end > 0 && isAsciiSpace(byteAt(s, end - 1))) {
    end--;
  }
  return s.slice(0, end);
}

export function trim(s: string): string {
  const n = s.byteLength;
  let lo: i32 = 0;
  while (lo < n && isAsciiSpace(byteAt(s, lo))) {
    lo++;
  }
  let hi = n;
  while (hi > lo && isAsciiSpace(byteAt(s, hi - 1))) {
    hi--;
  }
  return s.slice(lo, hi);
}

function matchAt(s: string, pos: i32, needle: string): bool {
  const m = needle.byteLength;
  if (pos + m > s.byteLength) {
    return false;
  }
  let j: i32 = 0;
  while (j < m) {
    if (byteAt(s, pos + j) !== byteAt(needle, j)) {
      return false;
    }
    j++;
  }
  return true;
}

function indexOfFrom(s: string, needle: string, start: i32): i32 {
  const n = s.byteLength;
  const m = needle.byteLength;
  if (m === 0) {
    return start <= n ? start : -1;
  }
  const lim = n - m;
  let i = start;
  while (i <= lim) {
    if (matchAt(s, i, needle)) {
      return i;
    }
    i++;
  }
  return -1;
}

export function lastIndexOf(s: string, needle: string): i32 {
  const n = s.byteLength;
  const m = needle.byteLength;
  if (m === 0) {
    return n;
  }
  if (m > n) {
    return -1;
  }
  let i = n - m;
  while (i >= 0) {
    if (matchAt(s, i, needle)) {
      return i;
    }
    i--;
  }
  return -1;
}

function pushStrBytes(buf: u8[], s: string): void {
  const n = s.byteLength;
  let i: i32 = 0;
  while (i < n) {
    buf.push(byteAt(s, i));
    i++;
  }
}

function pushSliceBytes(buf: u8[], s: string, lo: i32, hi: i32): void {
  let i = lo;
  while (i < hi) {
    buf.push(byteAt(s, i));
    i++;
  }
}

export function split(s: string, sep: string): string[] {
  const out: string[] = [];
  const n = s.byteLength;
  const m = sep.byteLength;
  if (m === 0) {
    let i: i32 = 0;
    while (i < n) {
      const step = utf8SeqLen(byteAt(s, i));
      out.push(s.slice(i, i + step));
      i += step;
    }
    return out;
  }
  let start: i32 = 0;
  while (start <= n) {
    const pos = indexOfFrom(s, sep, start);
    if (pos < 0) {
      out.push(s.slice(start, n));
      break;
    }
    out.push(s.slice(start, pos));
    start = pos + m;
  }
  return out;
}

export function replace(s: string, from: string, to: string): string {
  const m = from.byteLength;
  if (m === 0) {
    return `${to}${s}`;
  }
  const pos = s.indexOf(from);
  if (pos < 0) {
    return s;
  }
  const buf: u8[] = [];
  pushSliceBytes(buf, s, 0, pos);
  pushStrBytes(buf, to);
  pushSliceBytes(buf, s, pos + m, s.byteLength);
  return strFromUtf8Raw(buf, buf.length);
}

export function replaceAll(s: string, from: string, to: string): string {
  const n = s.byteLength;
  const m = from.byteLength;
  const buf: u8[] = [];
  if (m === 0) {
    pushStrBytes(buf, to);
    let i: i32 = 0;
    while (i < n) {
      const step = utf8SeqLen(byteAt(s, i));
      pushSliceBytes(buf, s, i, i + step);
      pushStrBytes(buf, to);
      i += step;
    }
    return strFromUtf8Raw(buf, buf.length);
  }
  let start: i32 = 0;
  while (start <= n) {
    const pos = indexOfFrom(s, from, start);
    if (pos < 0) {
      pushSliceBytes(buf, s, start, n);
      break;
    }
    pushSliceBytes(buf, s, start, pos);
    pushStrBytes(buf, to);
    start = pos + m;
  }
  return strFromUtf8Raw(buf, buf.length);
}

export function repeat(s: string, count: i32): string {
  if (count <= 0 || s.byteLength === 0) {
    return "";
  }
  const buf: u8[] = [];
  let k: i32 = 0;
  while (k < count) {
    pushStrBytes(buf, s);
    k++;
  }
  return strFromUtf8Raw(buf, buf.length);
}

function appendPadChars(buf: u8[], pad: string, needChars: i32): void {
  const plen = pad.byteLength;
  if (plen === 0 || needChars <= 0) {
    return;
  }
  let added: i32 = 0;
  while (added < needChars) {
    let i: i32 = 0;
    while (i < plen && added < needChars) {
      const step = utf8SeqLen(byteAt(pad, i));
      pushSliceBytes(buf, pad, i, i + step);
      i += step;
      added++;
    }
  }
}

export function padStart(s: string, targetLen: i32, pad: string = " "): string {
  const cur = charCount(s);
  if (targetLen <= cur || pad.byteLength === 0) {
    return s;
  }
  const buf: u8[] = [];
  appendPadChars(buf, pad, targetLen - cur);
  pushStrBytes(buf, s);
  return strFromUtf8Raw(buf, buf.length);
}

export function padEnd(s: string, targetLen: i32, pad: string = " "): string {
  const cur = charCount(s);
  if (targetLen <= cur || pad.byteLength === 0) {
    return s;
  }
  const buf: u8[] = [];
  pushStrBytes(buf, s);
  appendPadChars(buf, pad, targetLen - cur);
  return strFromUtf8Raw(buf, buf.length);
}

export function toUpperAscii(s: string): string {
  const n = s.byteLength;
  const buf: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    const b = byteAt(s, i);
    if (b >= 97u8 && b <= 122u8) {
      buf.push(b - 32u8);
    } else {
      buf.push(b);
    }
    i++;
  }
  return strFromUtf8Raw(buf, n);
}

export function toLowerAscii(s: string): string {
  const n = s.byteLength;
  const buf: u8[] = [];
  let i: i32 = 0;
  while (i < n) {
    const b = byteAt(s, i);
    if (b >= 65u8 && b <= 90u8) {
      buf.push(b + 32u8);
    } else {
      buf.push(b);
    }
    i++;
  }
  return strFromUtf8Raw(buf, n);
}

// -----------------------------------------------------------------------------
// Parsing: parseInt / parseInt32 / parseFloat
// -----------------------------------------------------------------------------

function digitVal(b: u8): i32 {
  if (b >= 48u8 && b <= 57u8) {
    return (b - 48u8) as i32;
  }
  if (b >= 65u8 && b <= 90u8) {
    return ((b - 65u8) as i32) + 10;
  }
  if (b >= 97u8 && b <= 122u8) {
    return ((b - 97u8) as i32) + 10;
  }
  return -1;
}

export function parseInt(s: string, radix: i32 = 10): Result<i64, string> {
  if (radix < 2 || radix > 36) {
    return Err("radix must be between 2 and 36");
  }
  const t = trim(s);
  const n = t.byteLength;
  if (n === 0) {
    return Err("empty integer string");
  }
  let i: i32 = 0;
  let neg = false;
  const first = byteAt(t, 0);
  if (first === 45u8) {
    neg = true;
    i = 1;
  } else if (first === 43u8) {
    i = 1;
  }
  if (i >= n) {
    return Err("missing digits");
  }
  const limit: u64 = neg ? 9223372036854775808u64 : 9223372036854775807u64;
  const base: u64 = radix as u64;
  let acc: u64 = 0u64;
  while (i < n) {
    const d = digitVal(byteAt(t, i));
    if (d < 0 || d >= radix) {
      return Err("invalid digit");
    }
    const du: u64 = d as u64;
    if (acc > (limit - du) / base) {
      return Err("integer overflow");
    }
    acc = acc * base + du;
    i++;
  }
  if (neg) {
    if (acc === 9223372036854775808u64) {
      return Ok(I64_MIN);
    }
    return Ok(-(acc as i64));
  }
  return Ok(acc as i64);
}

export function parseInt32(s: string, radix: i32 = 10): Result<i32, string> {
  const v = parseInt(s, radix)?;
  if (v < (I32_MIN as i64) || v > (I32_MAX as i64)) {
    return Err("i32 overflow");
  }
  return Ok(v as i32);
}

function pow10F64(exp: i32): f64 {
  // Exact IEEE-754 powers of 10 up to 10^22, composed by binary exponentiation.
  if (exp === 0) {
    return 1.0;
  }
  let e = exp < 0 ? -exp : exp;
  let base: f64 = 10.0;
  let res: f64 = 1.0;
  while (e > 0) {
    if ((e & 1) !== 0) {
      res = res * base;
    }
    e = e >> 1;
    if (e > 0) {
      base = base * base;
    }
  }
  return res;
}

export function parseFloat(s: string): Result<f64, string> {
  const t = trim(s);
  const n = t.byteLength;
  if (n === 0) {
    return Err("empty float string");
  }
  let i: i32 = 0;
  let neg = false;
  const first = byteAt(t, 0);
  if (first === 45u8) {
    neg = true;
    i = 1;
  } else if (first === 43u8) {
    i = 1;
  }
  if (i >= n) {
    return Err("missing digits");
  }
  const rest = toLowerAscii(t.slice(i, n));
  if (rest === "nan") {
    return Ok(NAN);
  }
  if (rest === "inf" || rest === "infinity") {
    return Ok(neg ? NEG_INF : INF);
  }
  let mant: u64 = 0u64;
  let sigDigits: i32 = 0;
  let decExp: i32 = 0;
  let seenDigit = false;
  let seenDot = false;
  while (i < n) {
    const b = byteAt(t, i);
    if (b >= 48u8 && b <= 57u8) {
      seenDigit = true;
      const d: u64 = (b - 48u8) as u64;
      if (sigDigits < 19) {
        if (mant !== 0u64 || d !== 0u64) {
          mant = mant * 10u64 + d;
          sigDigits++;
          if (seenDot) {
            decExp--;
          }
        } else if (seenDot) {
          decExp--;
        }
      } else if (!seenDot) {
        decExp++;
      }
      i++;
    } else if (b === 46u8 && !seenDot) {
      seenDot = true;
      i++;
    } else {
      break;
    }
  }
  if (!seenDigit) {
    return Err("invalid float literal");
  }
  if (i < n && (byteAt(t, i) === 101u8 || byteAt(t, i) === 69u8)) {
    i++;
    let expNeg = false;
    if (i < n && byteAt(t, i) === 45u8) {
      expNeg = true;
      i++;
    } else if (i < n && byteAt(t, i) === 43u8) {
      i++;
    }
    let expDigits = false;
    let expVal: i32 = 0;
    while (i < n) {
      const b = byteAt(t, i);
      if (b < 48u8 || b > 57u8) {
        return Err("invalid exponent digit");
      }
      expDigits = true;
      if (expVal < 10000) {
        expVal = expVal * 10 + ((b - 48u8) as i32);
      }
      i++;
    }
    if (!expDigits) {
      return Err("missing exponent digits");
    }
    decExp += expNeg ? -expVal : expVal;
  }
  if (i !== n) {
    return Err("unexpected trailing characters");
  }
  if (mant === 0u64) {
    return Ok(neg ? -0.0 : 0.0);
  }
  if (decExp > 310) {
    return Ok(neg ? NEG_INF : INF);
  }
  if (decExp < -350) {
    return Ok(neg ? -0.0 : 0.0);
  }
  let val: f64 = mant as f64;
  if (decExp > 0) {
    let e = decExp;
    while (e > 300) {
      val = val * 1e300;
      e -= 300;
    }
    val = val * pow10F64(e);
  } else if (decExp < 0) {
    let e = -decExp;
    while (e > 300) {
      val = val / 1e300;
      e -= 300;
    }
    val = val / pow10F64(e);
  }
  return Ok(neg ? -val : val);
}

// -----------------------------------------------------------------------------
// Formatting: toRadix / toRadixU64 / toRadixI32 / toFixed
// -----------------------------------------------------------------------------

function digitChar(d: u64): u8 {
  if (d < 10u64) {
    return (48u64 + d) as u8;
  }
  return (87u64 + d) as u8;
}

export function toRadixU64(n: u64, radix: i32): string {
  const r = radix < 2 ? 2 : (radix > 36 ? 36 : radix);
  const base: u64 = r as u64;
  if (n === 0u64) {
    return "0";
  }
  const rev: u8[] = [];
  let v = n;
  while (v > 0u64) {
    rev.push(digitChar(v % base));
    v = v / base;
  }
  const out: u8[] = [];
  let i = rev.length - 1;
  while (i >= 0) {
    out.push(rev[i]);
    i--;
  }
  return strFromUtf8Raw(out, out.length);
}

export function toRadix(n: i64, radix: i32): string {
  if (n < 0i64) {
    const mag: u64 = (0i64 -% n).wrapping<u64>();
    return `-${toRadixU64(mag, radix)}`;
  }
  return toRadixU64(n as u64, radix);
}

export function toRadixI32(n: i32, radix: i32): string {
  return toRadix(n as i64, radix);
}

export function toFixed(x: f64, digits: i32 = 0): string {
  if (x !== x) {
    return "NaN";
  }
  if (x === INF) {
    return "Infinity";
  }
  if (x === NEG_INF) {
    return "-Infinity";
  }
  const d = digits < 0 ? 0 : (digits > 20 ? 20 : digits);
  const neg = x < 0.0;
  const ax = abs(x);
  // Split integer and fractional parts cleanly without relying on str.from_f64.
  const intPart = floor(ax);
  const fracPart = ax - intPart;
  // Extract fractional digits (d + 1 digits to round half-away-from-zero).
  const fdigits: i32[] = [];
  let rem = fracPart;
  let k: i32 = 0;
  while (k <= d) {
    rem = rem * 10.0;
    let dig: i32 = floor(rem) as i32;
    if (dig > 9) {
      dig = 9;
    }
    if (dig < 0) {
      dig = 0;
    }
    fdigits.push(dig);
    rem = rem - (dig as f64);
    k++;
  }
  let carry: i32 = fdigits[d] >= 5 ? 1 : 0;
  let idx = d - 1;
  while (idx >= 0 && carry > 0) {
    const sum = fdigits[idx] + carry;
    if (sum >= 10) {
      fdigits[idx] = 0;
      carry = 1;
    } else {
      fdigits[idx] = sum;
      carry = 0;
    }
    idx--;
  }
  // Format integer part (handles values beyond u64::MAX by repeated division by 10).
  const intRounded = intPart + (carry as f64);
  const intRev: u8[] = [];
  if (intRounded < 1.8e19) {
    let iv: u64 = intRounded as u64;
    if (iv === 0u64) {
      intRev.push(48u8);
    } else {
      while (iv > 0u64) {
        intRev.push((48u64 + (iv % 10u64)) as u8);
        iv = iv / 10u64;
      }
    }
  } else {
    let v = intRounded;
    while (v >= 1.0) {
      const q = floor(v / 10.0);
      let r: i32 = floor(v - q * 10.0 + 0.5) as i32;
      if (r >= 10) {
        r = 9;
      }
      if (r < 0) {
        r = 0;
      }
      intRev.push((48 + r) as u8);
      v = q;
    }
  }
  const out: u8[] = [];
  // Avoid "-0" / "-0.00" when rounded result is all zeros.
  let allZero = intRev.length === 1 && intRev[0] === 48u8;
  if (allZero) {
    let j: i32 = 0;
    while (j < d) {
      if (fdigits[j] !== 0) {
        allZero = false;
        break;
      }
      j++;
    }
  }
  if (neg && !allZero) {
    out.push(45u8);
  }
  let p = intRev.length - 1;
  while (p >= 0) {
    out.push(intRev[p]);
    p--;
  }
  if (d > 0) {
    out.push(46u8);
    let j: i32 = 0;
    while (j < d) {
      out.push((48 + fdigits[j]) as u8);
      j++;
    }
  }
  return strFromUtf8Raw(out, out.length);
}
