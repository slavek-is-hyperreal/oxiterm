    case 33: return 0x7d7b8f7503cfdcfeu64;
    case 34: return 0x85bbe253f47b1417u64;
    case 35: return 0xa7709a56ccdf8a82u64;
    case 36: return 0x82bd6b70d99aaa6fu64;
    case 37: return 0xacca6da1e0a8ef29u64;
    case 38: return 0xddbb901b98feeab7u64;
    case 39: return 0x4b2d8644d8a74e18u64;
    case 40: return 0x73832eec6fff3111u64;
    case 41: return 0x47c6b82ef32a2069u64;
    case 42: return 0xe6a1158300d46640u64;
    default: return 0x213a4f0aa5e8a7b1u64;
  }
}

function pow5CoarseExp(k: i32): i32 {
  switch (k) {
    case 0: return -945;
    case 1: return -908;
    case 2: return -871;
    case 3: return -833;
    case 4: return -796;
    case 5: return -759;
    case 6: return -722;
    case 7: return -685;
    case 8: return -648;
    case 9: return -610;
    case 10: return -573;
    case 11: return -536;
    case 12: return -499;
    case 13: return -462;
    case 14: return -425;
    case 15: return -388;
    case 16: return -350;
    case 17: return -313;
    case 18: return -276;
    case 19: return -239;
    case 20: return -202;
    case 21: return -165;
    case 22: return -127;
    case 23: return -90;
    case 24: return -53;
    case 25: return -16;
    case 26: return 21;
    case 27: return 58;
    case 28: return 95;
    case 29: return 133;
    case 30: return 170;
    case 31: return 207;
    case 32: return 244;
    case 33: return 281;
    case 34: return 318;
    case 35: return 355;
    case 36: return 393;
    case 37: return 430;
    case 38: return 467;
    case 39: return 504;
    case 40: return 541;
    case 41: return 578;
    case 42: return 616;
    default: return 653;
  }
}

// Little-endian base-2^32 unsigned big integer helpers.
function bigNormalize(a: u32[]): void {
  while (a.length > 0 && a[a.length - 1] === 0u32) {
    const _ = a.pop();
  }
}

function bigFromU64(v: u64): u32[] {
  const out: u32[] = [];
  const lo: u32 = (v & 0xffff_ffffu64) as u32;
  const hi: u32 = (v >> 32u64) as u32;
  if (hi !== 0u32) {
    out.push(lo);
    out.push(hi);
  } else if (lo !== 0u32) {
    out.push(lo);
  }
  return out;
}

function bigBitLen(a: u32[]): i32 {
  const n = a.length;
  if (n === 0) {
    return 0;
  }
  const top = a[n - 1];
  return (n - 1) * 32 + (32 - (clz32(top) as i32));
}

function bigCmp(a: u32[], b: u32[]): i32 {
  if (a.length !== b.length) {
    return a.length < b.length ? -1 : 1;
  }
  let i = a.length - 1;
  while (i >= 0) {
    if (a[i] !== b[i]) {
      return a[i] < b[i] ? -1 : 1;
    }
    i--;
  }
  return 0;
}

function bigMulAddU32(a: u32[], mul: u32, add: u32): void {
  let carry: u64 = add as u64;
  const m64: u64 = mul as u64;
  const n = a.length;
  let i: i32 = 0;
  while (i < n) {
    const p = (a[i] as u64) *% m64 +% carry;
    a[i] = (p & 0xffff_ffffu64) as u32;
    carry = p >> 32u64;
    i++;
  }
  if (carry > 0u64) {
    a.push(carry as u32);
  }
}

function bigMulPow5(a: u32[], power: i32): void {
  let p = power;
  while (p >= 13) {
    bigMulAddU32(a, 1220703125u32, 0u32);
    p -= 13;
  }
  if (p > 0) {
    bigMulAddU32(a, pow5Small(p) as u32, 0u32);
  }
}

function bigShl(a: u32[], bits: i32): u32[] {
  if (a.length === 0) {
    return [];
  }
  if (bits === 0) {
    return a.slice(0, a.length);
  }
  const wordShift = bits / 32;
  const bitShift = bits % 32;
  const out: u32[] = [];
  let w: i32 = 0;
  while (w < wordShift) {
    out.push(0u32);
    w++;
  }
  const n = a.length;
  if (bitShift === 0) {
    let i: i32 = 0;
    while (i < n) {
      out.push(a[i]);
      i++;
    }
  } else {
    const bsu: u32 = bitShift as u32;
    const rsu: u32 = (32 - bitShift) as u32;
    let carry: u32 = 0u32;
    let i: i32 = 0;
    while (i < n) {
      const v = a[i];
      out.push((v << bsu) | carry);
      carry = v >> rsu;
      i++;
    }
    if (carry !== 0u32) {
      out.push(carry);
    }
  }
  return out;
}

function bigShl1InPlace(a: u32[]): void {
  let carry: u32 = 0u32;
  const n = a.length;
  let i: i32 = 0;
  while (i < n) {
    const v = a[i];
    const nextCarry = v >> 31u32;
    a[i] = (v << 1u32) | carry;
    carry = nextCarry;
    i++;
  }
  if (carry !== 0u32) {
    a.push(carry);
  }
}

function bigShr1InPlace(a: u32[]): void {
  let carry: u32 = 0u32;
  let i = a.length - 1;
  while (i >= 0) {
    const v = a[i];
    const nextCarry = (v & 1u32) << 31u32;
    a[i] = (v >> 1u32) | carry;
    carry = nextCarry;
    i--;
  }
  bigNormalize(a);
}

function bigSubInPlace(a: u32[], b: u32[]): void {
  let borrow: i64 = 0i64;
  const na = a.length;
  const nb = b.length;
  let i: i32 = 0;
  while (i < na) {
    const av: i64 = a[i] as i64;
    const bv: i64 = i < nb ? (b[i] as i64) : 0i64;
    const diff = av - bv - borrow;
    if (diff < 0i64) {
      a[i] = (diff + 4294967296i64) as u32;
      borrow = 1i64;
    } else {
      a[i] = diff as u32;
      borrow = 0i64;
    }
    i++;
  }
  bigNormalize(a);
}

function bigDivRemU32(a: u32[], d: u32): u32 {
  const d64: u64 = d as u64;
  let rem: u64 = 0u64;
  let i = a.length - 1;
  while (i >= 0) {
    const cur = (rem << 32u64) | (a[i] as u64);
    a[i] = (cur / d64) as u32;
    rem = cur % d64;
    i--;
  }
  bigNormalize(a);
  return rem as u32;
}

function parseFloatBigInt(t: string, firstSigPos: i32, dotPos: i32, mantEnd: i32, expSigned: i32, neg: bool): f64 {
  // Parse up to 768 significant decimal digits starting at firstSigPos into bigD,
  // collapsing any remaining non-zero digits into a single sticky digit (Gay / Clinger 1990).
  const bigD: u32[] = [];
  let sigCount: i32 = 0;
  let seenDot = firstSigPos > dotPos;
  let decExp: i32 = seenDot ? -(firstSigPos - dotPos - 1) : 0;
  let sticky = false;
  let chunk: u32 = 0u32;
  let chunkLen: i32 = 0;
  let chunkMul: u32 = 1u32;
  let p = firstSigPos;
  while (p < mantEnd && sigCount < 768) {
    const b = byteAt(t, p);
    if (b === 46u8) {
      seenDot = true;
      p = p +% 1;
      continue;
    }
    const d: u32 = (b -% 48u8) as u32;
    chunk = chunk *% 10u32 +% d;
    chunkMul = chunkMul *% 10u32;
    chunkLen = chunkLen +% 1;
    sigCount = sigCount +% 1;
    if (seenDot) {
      decExp = decExp -% 1;
    }
    if (chunkLen === 9) {
      bigMulAddU32(bigD, 1000000000u32, chunk);
      chunk = 0u32;
      chunkLen = 0;
      chunkMul = 1u32;
    }
    p = p +% 1;
  }
  if (p < mantEnd) {
    if (p < dotPos) {
      decExp = decExp + (dotPos - p);
      while (p < dotPos && byteAt(t, p) === 48u8) {
        p = p +% 1;
      }
      if (p < dotPos) {
        sticky = true;
      } else if (dotPos < mantEnd) {
        p = dotPos +% 1;
        while (p < mantEnd && byteAt(t, p) === 48u8) {
          p = p +% 1;
        }
        if (p < mantEnd) {
          sticky = true;
        }
      }
    } else {
      if (p === dotPos) {
        p = p +% 1;
      }
      while (p < mantEnd && byteAt(t, p) === 48u8) {
        p = p +% 1;
      }
      if (p < mantEnd) {
        sticky = true;
      }
    }
  }
  if (chunkLen > 0) {
    bigMulAddU32(bigD, chunkMul, chunk);
  }
  if (sticky) {
    bigMulAddU32(bigD, 10u32, 1u32);
    decExp--;
  }
  bigNormalize(bigD);
  if (bigD.length === 0) {
    return neg ? -0.0 : 0.0;
  }
  const q = decExp + expSigned;
  // Build exact ratio (num / den) * 2^q = bigD * 5^q * 2^q.
  let num: u32[] = bigD;
  let den: u32[] = [1u32];
  if (q > 0) {
    bigMulPow5(num, q);
  } else if (q < 0) {
    bigMulPow5(den, -q);
  }
  // Find exact exp2 such that 2^exp2 <= (num / den) * 2^q < 2^(exp2 + 1).
  const nb = bigBitLen(num);
  const mb = bigBitLen(den);
  const diff = nb - mb;
  let cmpRes: i32 = 0;
  if (diff > 0) {
    cmpRes = bigCmp(num, bigShl(den, diff));
  } else if (diff < 0) {
    cmpRes = bigCmp(bigShl(num, -diff), den);
  } else {
    cmpRes = bigCmp(num, den);
  }
  const exp2 = cmpRes < 0 ? (q + diff - 1) : (q + diff);
  if (exp2 >= 1024) {
    return neg ? NEG_INF : INF;
  }
  if (exp2 < -1075) {
    return neg ? -0.0 : 0.0;
  }
  const lsbExp = exp2 >= -1022 ? (exp2 - 52) : -1074;
  const shift = q - lsbExp;
  if (shift > 0) {
    num = bigShl(num, shift);
  } else if (shift < 0) {
    den = bigShl(den, -shift);
  }
  // Exact binary long division: quot = floor(num / den) (< 2^53), rem = num % den.
  const maxBit = bigBitLen(num) - bigBitLen(den);
  let quot: u64 = 0u64;
  const rem: u32[] = num;
  if (maxBit >= 0) {
    const dShift = bigShl(den, maxBit);
    let bit = maxBit;
    while (bit >= 0) {
      if (bigCmp(rem, dShift) >= 0) {
        bigSubInPlace(rem, dShift);
        quot = quot | (1u64 << (bit as u64));
      }
      if (bit > 0) {
        bigShr1InPlace(dShift);
      }
      bit--;
    }
  }
  // Exact round-half-to-even: compare 2 * rem vs den.
  bigShl1InPlace(rem);
  const c = bigCmp(rem, den);
  if (c > 0 || (c === 0 && (quot & 1u64) !== 0u64)) {
    quot = quot + 1u64;
  }
  const signBit: u64 = neg ? 0x8000_0000_0000_0000u64 : 0u64;
  if (lsbExp === -1074) {
    // Subnormal (or promoted to min normal 0x0010_0000_0000_0000 when quot === 2^52).
    return fromBits(signBit | quot);
  }
  let biased = exp2 + 1023;
  if (quot === (1u64 << 53u64)) {
    quot = quot >> 1u64;
    biased++;
  }
  if (biased >= 2047) {
    return neg ? NEG_INF : INF;
  }
  const bits = signBit | (((biased as u64) << 52u64) | (quot & 0x000f_ffff_ffff_ffffu64));
  return fromBits(bits);
}

export function parseFloat(s: string): Result<f64, string> {
  const t = trim(s);
  const n = t.byteLength;
  if (n === 0) {
    return Err("empty float string");
  }
  let i: i32 = 0;
  let neg = false;
  const first = byteAt(t, 0);
  if (first === 45u8) {
    neg = true;
    i = 1;
  } else if (first === 43u8) {
    i = 1;
  }
  if (i >= n) {
    return Err("missing digits");
  }
  const ch0 = byteAt(t, i);
  if (ch0 === 78u8 || ch0 === 110u8 || ch0 === 73u8 || ch0 === 105u8) {
    const rest = toLowerAscii(t.slice(i, n));
    if (rest === "nan") {
      return Ok(NAN);
    }
    if (rest === "inf" || rest === "infinity") {
      return Ok(neg ? NEG_INF : INF);
    }
  }
  let mant: u64 = 0u64;
  let sigDigits: i32 = 0;
  let decExp: i32 = 0;
  let truncated = false;
  let seenDigit = false;
  let firstSigPos: i32 = -1;
  // Integer leading zeros
  const intZeroStart = i;
  while (i < n && byteAt(t, i) === 48u8) {
    i = i +% 1;
  }
  if (i > intZeroStart) {
    seenDigit = true;
  }
  // Integer significant digits (first 19 into mant)
  while (i < n && sigDigits < 19) {
    const b = byteAt(t, i);
    if ((b -% 48u8) > 9u8) {
      break;
    }
    if (firstSigPos < 0) {
      firstSigPos = i;
    }
    seenDigit = true;
    mant = mant *% 10u64 +% ((b -% 48u8) as u64);
    sigDigits = sigDigits +% 1;
    i = i +% 1;
  }
  // Remaining integer digits beyond 19
  if (i < n && (byteAt(t, i) -% 48u8) <= 9u8) {
    const extraStart = i;
    while (i < n && byteAt(t, i) === 48u8) {
      i = i +% 1;
    }
    if (i < n && (byteAt(t, i) -% 48u8) <= 9u8) {
      truncated = true;
      i = i +% 1;
      while (i < n && (byteAt(t, i) -% 48u8) <= 9u8) {
        i = i +% 1;
      }
    }
    decExp = decExp + (i - extraStart);
  }
  let dotPos = i;
  // Fractional part
  if (i < n && byteAt(t, i) === 46u8) {
    dotPos = i;
    i = i +% 1;
    if (sigDigits === 0) {
      const fracZeroStart = i;
      while (i < n && byteAt(t, i) === 48u8) {
        i = i +% 1;
      }
      if (i > fracZeroStart) {
        seenDigit = true;
        decExp = decExp - (i - fracZeroStart);
      }
    }
    if (sigDigits < 19) {
      const fracSigStart = i;
      while (i < n && sigDigits < 19) {
        const b = byteAt(t, i);
        if ((b -% 48u8) > 9u8) {
          break;
        }
        if (firstSigPos < 0) {
          firstSigPos = i;
        }
        seenDigit = true;
        mant = mant *% 10u64 +% ((b -% 48u8) as u64);
        sigDigits = sigDigits +% 1;
        i = i +% 1;
      }
      decExp = decExp - (i - fracSigStart);
    }
    // Remaining fractional digits beyond 19
    if (i < n && (byteAt(t, i) -% 48u8) <= 9u8) {
      if (!truncated) {
        while (i < n && byteAt(t, i) === 48u8) {
          i = i +% 1;
        }
        if (i < n && (byteAt(t, i) -% 48u8) <= 9u8) {
          truncated = true;
          i = i +% 1;
        }
      }
      while (i < n && (byteAt(t, i) -% 48u8) <= 9u8) {
        i = i +% 1;
      }
    }
  }
  const mantEnd = i;
  if (!seenDigit) {
    return Err("invalid float literal");
  }
  let expSigned: i32 = 0;
  if (i < n && (byteAt(t, i) === 101u8 || byteAt(t, i) === 69u8)) {
    i = i +% 1;
    let expNeg = false;
    if (i < n && byteAt(t, i) === 45u8) {
      expNeg = true;
      i = i +% 1;
    } else if (i < n && byteAt(t, i) === 43u8) {
      i = i +% 1;
    }
    let expDigits = false;
    let expVal: i32 = 0;
    while (i < n) {
      const b = byteAt(t, i);
      if ((b -% 48u8) > 9u8) {
        return Err("invalid exponent digit");
      }
      expDigits = true;
      if (expVal < 10000000) {
        expVal = expVal * 10 + ((b -% 48u8) as i32);
      }
      i = i +% 1;
    }
    if (!expDigits) {
      return Err("missing exponent digits");
    }
    expSigned = expNeg ? -expVal : expVal;
    decExp += expSigned;
  }
  if (i !== n) {
    return Err("unexpected trailing characters");
  }
  if (mant === 0u64) {
    return Ok(neg ? -0.0 : 0.0);
  }
  const sciExp = decExp + sigDigits - 1;
  if (sciExp > 309) {
    return Ok(neg ? NEG_INF : INF);
  }
  if (sciExp < -325) {
    return Ok(neg ? -0.0 : 0.0);
  }
  // Strip trailing decimal zeros when exact so inputs like 1000...e-n hit the fast paths.
  if (!truncated) {
    while (mant % 10u64 === 0u64 && (mant > 9007199254740991u64 || decExp < 0)) {
      mant = mant / 10u64;
      decExp++;
    }
  }
  // Fast path 1 (Clinger 1990): exact f64 significand and exact power of 10.
  if (!truncated && mant <= 9007199254740991u64 && decExp >= -22 && decExp <= 22) {
    const p10 = pow10Exact(decExp < 0 ? -decExp : decExp);
    const val = decExp >= 0 ? ((mant as f64) * p10) : ((mant as f64) / p10);
    return Ok(neg ? -val : val);
  }
  // Fast path 2 (Eisel-Lemire 128-bit): exact 19-digit mantissa, q in [-348, 347].
  if (!truncated && decExp >= -348 && decExp <= 347) {
    const lz = clz64(mant);
    const w = mant << lz;
    const k = (decExp + 352) / 16;
    const rem = (decExp + 352) - k * 16;
    let qHi = pow5CoarseHi(k);
    let qLo = pow5CoarseLo(k);
    let eQ = pow5CoarseExp(k);
    if (rem > 0) {
      const m = pow5Small(rem);
      const lo0 = qLo *% m;
      const hi0 = mul64Hi(qLo, m);
      const lo1 = qHi *% m;
      const hi1 = mul64Hi(qHi, m);
      const midP = lo1 +% hi0;
      const top = hi1 +% (midP < lo1 ? 1u64 : 0u64);
      const sh: i32 = 64 - (clz64(top) as i32);
      const rsh: u64 = sh as u64;
      const lsh: u64 = (64 - sh) as u64;
      qHi = (top << lsh) | (midP >> rsh);
      qLo = (midP << lsh) | (lo0 >> rsh);
      eQ += sh;
    }
    const p1Hi = mul64Hi(w, qHi);
    const p1Lo = w *% qHi;
    const p0Hi = mul64Hi(w, qLo);
    const mid = p1Lo +% p0Hi;
    const hi = p1Hi +% (mid < p1Lo ? 1u64 : 0u64);
    // Error bound: true_mid - mid in [0, 4). Reject if mid could carry into hi.
    if (mid < 0xffff_ffff_ffff_fffbu64) {
      const msb: i32 = (hi >> 63u64) as i32;
      const exp2 = 190 + msb + decExp - (lz as i32) + eQ;
      let biased = exp2 + 1023;
      if (biased >= 2047) {
        return Ok(neg ? NEG_INF : INF);
      }
      if (biased <= -54) {
        return Ok(neg ? -0.0 : 0.0);
      }
      const rshift = biased >= 1 ? (10 + msb) : (10 + msb + 1 - biased);
      if (rshift <= 62) {
        const rsu: u64 = rshift as u64;
        const mask = (1u64 << rsu) - 1u64;
        const half = 1u64 << (rsu - 1u64);
        const remHi = hi & mask;
        if (remHi !== half || mid > 0u64) {
          let sig = hi >> rsu;
          if (remHi >= half) {
            sig = sig + 1u64;
          }
          const signBit: u64 = neg ? 0x8000_0000_0000_0000u64 : 0u64;
          if (biased <= 0) {
            return Ok(fromBits(signBit | sig));
          }
          if (sig === (1u64 << 53u64)) {
            sig = sig >> 1u64;
            biased++;
          }
          if (biased >= 2047) {
            return Ok(neg ? NEG_INF : INF);
          }
          return Ok(fromBits(signBit | (((biased as u64) << 52u64) | (sig & 0x000f_ffff_ffff_ffffu64))));
        }
      }
    }
  }
  // Exact BigUint fallback for >19-digit inputs and all halfway / ambiguous cases.
  return Ok(parseFloatBigInt(t, firstSigPos, dotPos, mantEnd, expSigned, neg));
}

// -----------------------------------------------------------------------------
// Formatting: toRadix / toRadixU64 / toRadixI32 / toFixed
// -----------------------------------------------------------------------------

function digitChar(d: u64): u8 {
  if (d < 10u64) {
    return (48u64 + d) as u8;
  }
  return (87u64 + d) as u8;
}

export function toRadixU64(n: u64, radix: i32): string {
  if (radix < 2 || radix > 36) {
    const _ = byteAt("", 0);
  }
  const base: u64 = radix as u64;
  if (n === 0u64) {
    return "0";
  }
  const rev: u8[] = [];
  let v = n;
  while (v > 0u64) {
    rev.push(digitChar(v % base));
    v = v / base;
  }
  const out: u8[] = [];
  let i = rev.length - 1;
  while (i >= 0) {
    out.push(rev[i]);
    i--;
  }
  return strFromUtf8Raw(out, out.length);
}

export function toRadix(n: i64, radix: i32): string {
  if (n < 0i64) {
    const mag: u64 = (0i64 -% n).wrapping<u64>();
    return `-${toRadixU64(mag, radix)}`;
  }
  return toRadixU64(n as u64, radix);
}

export function toRadixI32(n: i32, radix: i32): string {
  return toRadix(n as i64, radix);
}

function formatZeroFixed(digits: i32): string {
  if (digits === 0) {
    return "0";
  }
  const out: u8[] = [48u8, 46u8];
  let k: i32 = 0;
  while (k < digits) {
    out.push(48u8);
    k++;
  }
  return strFromUtf8Raw(out, out.length);
}

function formatU128Fixed(hiIn: u64, loIn: u64, digits: i32, neg: bool): string {
  if (hiIn === 0u64 && loIn === 0u64) {
    return formatZeroFixed(digits);
  }
  const rev: u8[] = [];
  let hi = hiIn;
  let lo = loIn;
  while (hi > 0u64 || lo > 0u64) {
    if (hi === 0u64) {
      rev.push((48u64 + (lo % 10u64)) as u8);
      lo = lo / 10u64;
    } else {
      const qh = hi / 10u64;
      const rh = hi % 10u64;
      const mid = (rh << 32u64) | (lo >> 32u64);
      const qm = mid / 10u64;
      const rm = mid % 10u64;
      const bot = (rm << 32u64) | (lo & 0xffff_ffffu64);
      const qb = bot / 10u64;
      const rem = bot % 10u64;
      rev.push((48u64 + rem) as u8);
      hi = qh;
      lo = (qm << 32u64) | qb;
    }
  }
  const out: u8[] = [];
  if (neg) {
    out.push(45u8);
  }
  const len = rev.length;
  if (digits === 0) {
    let i = len - 1;
    while (i >= 0) {
      out.push(rev[i]);
      i--;
    }
    return strFromUtf8Raw(out, out.length);
  }
  if (len <= digits) {
    out.push(48u8);
    out.push(46u8);
    let pad = digits - len;
    while (pad > 0) {
      out.push(48u8);
      pad--;
    }
    let i = len - 1;
    while (i >= 0) {
      out.push(rev[i]);
      i--;
    }
  } else {
    let i = len - 1;
    while (i >= digits) {
      out.push(rev[i]);
      i--;
    }
    out.push(46u8);
    while (i >= 0) {
      out.push(rev[i]);
      i--;
    }
  }
  return strFromUtf8Raw(out, out.length);
}

export function toFixed(x: f64, digits: i32 = 0): string {
  if (digits < 0 || digits > 20) {
    const _ = byteAt("", 0);
  }
  if (x !== x) {
    return "NaN";
  }
  if (x === INF) {
    return "Infinity";
  }
  if (x === NEG_INF) {
    return "-Infinity";
  }
  const u = bitsOf(x);
  const neg = (u >> 63u64) !== 0u64;
  const rawExp: i32 = ((u >> 52u64) & 0x7ffu64) as i32;
  const rawMant: u64 = u & 0x000f_ffff_ffff_ffffu64;
  if (rawExp === 0 && rawMant === 0u64) {
    return formatZeroFixed(digits);
  }
  const sig: u64 = rawExp === 0 ? rawMant : (rawMant | 0x0010_0000_0000_0000u64);
  const exp2: i32 = rawExp === 0 ? -1074 : (rawExp - 1075);

  // Case 1: exact integer value (|x| = sig * 2^exp2, fractional digits all zero).
  if (exp2 >= 0) {
    const out: u8[] = [];
    if (neg) {
      out.push(45u8);
    }
    if (exp2 <= 11) {
      let iv: u64 = sig << (exp2 as u64);
      const rev: u8[] = [];
      while (iv > 0u64) {
        rev.push((48u64 + (iv % 10u64)) as u8);
        iv = iv / 10u64;
      }
      let p = rev.length - 1;
      while (p >= 0) {
        out.push(rev[p]);
        p--;
      }
    } else {
      // Exact BigUint decimal expansion (handles up to f64::MAX without trapping).
      const bigInt = bigShl(bigFromU64(sig), exp2);
      const chunks: u32[] = [];
      while (bigInt.length > 0) {
        chunks.push(bigDivRemU32(bigInt, 1000000000u32));
      }
      let ci = chunks.length - 1;
      // Top chunk without leading zeros.
      let top = chunks[ci];
      const topRev: u8[] = [];
      while (top > 0u32) {
        topRev.push((48u32 + (top % 10u32)) as u8);
        top = top / 10u32;
      }
      let tp = topRev.length - 1;
      while (tp >= 0) {
        out.push(topRev[tp]);
        tp--;
      }
      ci--;
      // Subsequent chunks padded to 9 digits.
      while (ci >= 0) {
        let v = chunks[ci];
        let div: u32 = 100000000u32;
        while (div > 0u32) {
          out.push((48u32 + (v / div)) as u8);
          v = v % div;
          div = div / 10u32;
        }
        ci--;
      }
    }
    if (digits > 0) {
      out.push(46u8);
      let k: i32 = 0;
      while (k < digits) {
        out.push(48u8);
        k++;
      }
    }
    return strFromUtf8Raw(out, out.length);
  }

  // Case 2: exact scaled integer (|x| * 10^digits = sig * 5^digits * 2^(exp2 + digits), < 2^119).
  const s = exp2 + digits;
  if (s >= 0) {
    const p5 = pow5Small(digits);
    const pLo = sig *% p5;
    const pHi = mul64Hi(sig, p5);
    if (s === 0) {
      return formatU128Fixed(pHi, pLo, digits, neg);
    }
    const su: u64 = s as u64;
    const qHi = (pHi << su) | (pLo >> (64u64 - su));
    const qLo = pLo << su;
    return formatU128Fixed(qHi, qLo, digits, neg);
  }

  // Case 3: |x| * 10^digits = (sig * 5^digits) / 2^sh with exact round-half-to-even.
  const sh = -s;
  if (sh > 101) {
    // sig * 5^digits < 2^100, so (sig * 5^digits) / 2^sh < 0.5 strictly.
    return formatZeroFixed(digits);
  }
  const p5 = pow5Small(digits);
  const pLo = sig *% p5;
  const pHi = mul64Hi(sig, p5);
  let qHi: u64 = 0u64;
  let qLo: u64 = 0u64;
  let halfBit: u64 = 0u64;
  let sticky = false;
  if (sh < 64) {
    const shu: u64 = sh as u64;
    qHi = pHi >> shu;
    qLo = (pHi << (64u64 - shu)) | (pLo >> shu);
    halfBit = (pLo >> (shu - 1u64)) & 1u64;
    const stickyMask = (1u64 << (shu - 1u64)) - 1u64;
    sticky = (pLo & stickyMask) !== 0u64;
  } else if (sh === 64) {
    qHi = 0u64;
    qLo = pHi;
    halfBit = pLo >> 63u64;
    sticky = (pLo & 0x7fff_ffff_ffff_ffffu64) !== 0u64;
  } else {
    const k: u64 = (sh - 64) as u64;
    qHi = 0u64;
    qLo = pHi >> k;
    halfBit = (pHi >> (k - 1u64)) & 1u64;
    const stickyMask = (1u64 << (k - 1u64)) - 1u64;
    sticky = ((pHi & stickyMask) !== 0u64) || pLo !== 0u64;
  }
  if (halfBit === 1u64 && (sticky || (qLo & 1u64) !== 0u64)) {
    qLo = qLo +% 1u64;
    if (qLo === 0u64) {
      qHi = qHi +% 1u64;
    }
  }
  return formatU128Fixed(qHi, qLo, digits, neg);
}
