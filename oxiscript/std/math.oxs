// OxiScript standard library: std/math
// Hardware-mapped intrinsics, numeric constants, bit operations, and integer math.

// -----------------------------------------------------------------------------
// Float intrinsics (1:1 OxiIR / Wasm ops)
// -----------------------------------------------------------------------------

@intrinsic("abs")
export function abs(x: f64): f64 {
  return x;
}

@intrinsic("sqrt")
export function sqrt(x: f64): f64 {
  return x;
}

@intrinsic("floor")
export function floor(x: f64): f64 {
  return x;
}

@intrinsic("ceil")
export function ceil(x: f64): f64 {
  return x;
}

@intrinsic("trunc")
export function trunc(x: f64): f64 {
  return x;
}

@intrinsic("nearest")
export function round(x: f64): f64 {
  return x;
}

@intrinsic("min")
export function min(a: f64, b: f64): f64 {
  return a;
}

@intrinsic("max")
export function max(a: f64, b: f64): f64 {
  return a;
}

@intrinsic("bitcast")
export function bitsOf(x: f64): u64 {
  return 0u64;
}

@intrinsic("bitcast")
export function fromBits(bits: u64): f64 {
  return 0.0;
}

@intrinsic("abs")
export function absF32(x: f32): f32 {
  return x;
}

@intrinsic("sqrt")
export function sqrtF32(x: f32): f32 {
  return x;
}

@intrinsic("floor")
export function floorF32(x: f32): f32 {
  return x;
}

@intrinsic("ceil")
export function ceilF32(x: f32): f32 {
  return x;
}

@intrinsic("trunc")
export function truncF32(x: f32): f32 {
  return x;
}

@intrinsic("nearest")
export function roundF32(x: f32): f32 {
  return x;
}

@intrinsic("min")
export function minF32(a: f32, b: f32): f32 {
  return a;
}

@intrinsic("max")
export function maxF32(a: f32, b: f32): f32 {
  return a;
}

@intrinsic("bitcast")
export function bitsOfF32(x: f32): u32 {
  return 0u32;
}

@intrinsic("bitcast")
export function fromBitsF32(bits: u32): f32 {
  return 0.0f32;
}

